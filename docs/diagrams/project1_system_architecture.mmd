flowchart LR
    %% Streaming ingestion -> batch feature computation -> API serving

    subgraph SRC["Event source"]
        GEN["data-generator/producer.py<br/>synthetic events, schema 4.0<br/>stable profile per user_id"]
    end

    subgraph KAFKA["Kafka (single broker)"]
        TOPIC["user_events<br/>3 partitions, key = user_id"]
        DLQ["user_events_dlq<br/>raw JSON of rejected events"]
    end

    subgraph STREAM["Streaming ingestion: spark-streaming/read_stream.py"]
        PARSE["Parse JSON with typed schema<br/>try_to_timestamp(event_time)"]
        VALIDATE{"is_valid<br/>required fields + value rules,<br/>NULL counts as invalid"}
        CKPT[("checkpoints/<br/>bronze_user_events, dlq")]
    end

    subgraph LAKE["Parquet storage (data/)"]
        BRONZE[("Bronze<br/>data/bronze/user_events<br/>valid events, duplicates kept")]
        DIMS[("Reference dims<br/>data/dim/users, data/dim/products")]
        SILVER[("Silver<br/>data/silver/user_events")]
        GOLD[("Gold<br/>data/gold/user_features<br/>one row per user")]
    end

    subgraph BATCH["Batch feature computation (manual or Airflow DAG)"]
        REF["reference-data/create_reference_data.py<br/>dims from the producer catalog and profiles"]
        B2S["spark-batch/bronze_to_silver.py<br/>dedup by event_id, left-join dims,<br/>reference-missing flags"]
        S2G["spark-batch/silver_to_gold.py<br/>GROUP BY user_id"]
        PUB["spark-batch/publish_gold_to_postgres.py<br/>JDBC to staging, validate,<br/>swap in one transaction"]
    end

    subgraph SERVE["Serving"]
        PG[("PostgreSQL<br/>user_features<br/>PRIMARY KEY (user_id)")]
        API["FastAPI api/main.py<br/>/health, /features/{user_id}, /metrics"]
    end

    subgraph OBS["Monitoring: monitoring/run_monitoring.sh"]
        KEXP["kafka-exporter :9308"]
        FEXP["feature-freshness-exporter :8001"]
        PROM["Prometheus :9090"]
        GRAF["Grafana :3000"]
    end

    GEN -- "key = user_id" --> TOPIC
    TOPIC --> PARSE --> VALIDATE
    VALIDATE -- "valid" --> BRONZE
    VALIDATE -- "invalid" --> DLQ
    STREAM -. "offsets" .-> CKPT

    REF --> DIMS
    BRONZE --> B2S
    DIMS --> B2S
    B2S --> SILVER --> S2G --> GOLD --> PUB --> PG
    PG --> API

    TOPIC -.-> KEXP
    DLQ -.-> KEXP
    PG -.-> FEXP
    API -. "/metrics" .-> PROM
    KEXP -.-> PROM
    FEXP -.-> PROM
    PROM --> GRAF
